{
  "openapi": "3.0.3",
  "info": {
    "title": "BoltRoute customer MCP and agent access",
    "version": "1.0.0",
    "description": "Companion to the existing customer REST API. These routes are enabled by default in the owning customer API; an explicit off switch disables them. The existing Better Auth trust settings and application migrations are required. ConsoleSession is the verified native customer account API JWT; customer API keys cannot mint connections or approve browser consent. OAuth requires exact redirect matching, PKCE S256, state and resource binding. Secrets are returned only by issuance/token endpoints with Cache-Control: no-store."
  },
  "servers": [
    {
      "url": "https://api.boltroute.ai"
    }
  ],
