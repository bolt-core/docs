    "/mcp": {
      "post": {
        "summary": "Authenticated stateless Streamable HTTP MCP",
        "description": "Official MCP SDK endpoint. Revalidates key/grant, scope, expiry and revocation on every request. Maximum input/output 1 MiB and request deadline 30 seconds; runtime configuration can lower these bounds. Use tools/list for authoritative tool schemas. New side effects require workload_authorized=true and a stable request_id. A client disconnect does not cancel accepted asynchronous work.",
        "security": [
          {
            "CustomerBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MCPRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC response or protocol error; safe tool failures use isError and structured error codes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "Accepted MCP notification"
          },
          "401": {
            "description": "Missing/expired/revoked credential",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "description": "Bearer resource_metadata points to protected-resource metadata."
                }
              }
            }
          },
          "403": {
            "description": "Origin or scope denied"
          },
          "413": {
            "description": "Input bound exceeded"
          },
          "503": {
            "description": "Admission/deadline/service unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CustomerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing customer API key, scoped connection token or OAuth access token."
      },
      "ConsoleSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Short-lived asymmetric Better Auth API JWT from the current verified customer account. The configured issuer, audience, signing keys and current account state are checked. Browser cookies, session tokens and legacy Supabase tokens cannot authorize these routes; accounts are never merged by email."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Connection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "verification:read",
                "verification:write",
                "credits:read"
              ]
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "last_used_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "client_name": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "scopes",
          "created_at",
          "expires_at",
          "revoked_at"
        ]
      },
      "ConnectionList": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "verification:read",
                "verification:write",
                "credits:read"
              ]
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          },
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Connection"
            },
            "maxItems": 100
          }
        },
        "required": [
          "endpoint",
          "scopes_supported",
          "connections"
        ]
      },
      "CreateConnection": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "verification:read",
                "verification:write",
                "credits:read"
              ]
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          },
          "expires_in": {
            "type": "integer",
            "minimum": 60,
            "maximum": 2592000,
            "default": 604800
          }
        },
        "required": [
          "name",
          "scopes"
        ],
        "additionalProperties": false
      },
      "IssuedConnection": {
        "type": "object",
        "properties": {
          "connection": {
            "$ref": "#/components/schemas/Connection"
          },
          "token": {
